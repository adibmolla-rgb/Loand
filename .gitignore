# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Node
node_modules/
npm-debug.log*

# Secrets and local settings
.env
.env.*
.claude/settings.local.json

# Python (the old converter is gone; kept so stray caches never get committed)
__pycache__/
*.pyc

# Logs and scratch
*.log
*.tmp

# The research workbook IS committed, on purpose: it's the provenance of every
# fact on the site, and scripts/build-data.js is useless without it. Each
# release adds roughly 250KB, which is a fine price for a self-contained
# repo. Git can't diff it, so treat each release as a whole new file.
# The generated files (data/research.js, data/meta.js, data/json/) are also
# committed so the site works without a build step; CI checks they are current.
